# Data source: 'local' (default) or 'cloud'
# 'local' reads from the reMarkable desktop app cache (recommended)
# 'cloud' uses the reMarkable Cloud API (requires device token)
REMARKABLE_SOURCE=local

# Optional: Custom path to reMarkable desktop app cache
# Default on macOS: ~/Library/Containers/com.remarkable.desktop/Data/Library/Application Support/remarkable/desktop/
# REMARKABLE_LOCAL_CACHE_PATH=

# reMarkable Cloud credentials (only needed if REMARKABLE_SOURCE=cloud)
# To get a device token, run: remarkawise auth remarkable
REMARKABLE_DEVICE_TOKEN=

# Readwise Reader API token
# Get your token from: https://readwise.io/access_token
READWISE_ACCESS_TOKEN=

# Optional: Sync configuration
# SYNC_INTERVAL_MINUTES=60
# SYNC_FOLDERS=Books,Papers
